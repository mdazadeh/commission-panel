        "customer_meetings_monthly_target": 12,
        "monthly_bands": [
            {
                "below": "0.70",
                "deduction": "0.20",
                "deduction_if_monthly_target_met": "0.10"
            },
            {
                "below": "1.00",
                "deduction": "0.10"
            }
        ],
        "aggregation": "worst_indicator_sum_of_months",
